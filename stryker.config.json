{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "mutate": [
    "src/lib/pdf/**",
    "src/hooks/useReport*.js",
    "src/hooks/useWorkOrders*.js"
  ],
  "ignorePatterns": [
    "**/__tests__/**",
    "**/*.test.*",
    "**/node_modules/**"
  ],
  "thresholds": {
    "high": 80,
    "low": 50,
    "break": 50
  }
}
