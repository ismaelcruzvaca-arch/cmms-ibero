{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "mutate": [
    "src/lib/pdf/**",
    "src/hooks/useReport*.js",
    "src/hooks/useWorkOrders*.js"
  ],
  "ignorePatterns": [
    "**/node_modules/**"
  ],
  "vitest": {
    "configFile": "vite.config.js"
  },
  "timeoutMS": 300000,
  "coverageAnalysis": "off",
  "concurrency": 2,
  "thresholds": {
    "high": 80,
    "low": 50,
    "break": 50
  }
}
