# Supabase Configuration
# Copia este archivo como .env y completa con tus valores

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# PDF Server Generation (Edge Function)
# Browserless.io API key para conversión HTML → PDF
BROWSERLESS_API_KEY=tu-browserless-api-key-aqui

# Tiempo de expiración de la signed URL en segundos (default: 3600 = 1 hora)
# Rango permitido: 300 (5 min) — 86400 (24 h)
SIGNED_URL_EXPIRY_SECONDS=3600

# Email Delivery (Resend)
# Resend.com API key para envío de reportes por email
RESEND_API_KEY=re_xxxxxxxxxxxx
# Dirección de correo remitente (debe estar verificada en Resend)
RESEND_FROM_EMAIL="CMMS Ibero <reports@tu-dominio.com>"

# Scheduled Reports (pg_cron → Edge Function)
# Secreto compartido para autenticación interna entre pg_cron y send-report EF.
# Debe coincidir con el valor en report_schedule_config.internal_secret.
# Generar con: openssl rand -hex 32
INTERNAL_SECRET=genera-un-secreto-aleatorio-aqui
