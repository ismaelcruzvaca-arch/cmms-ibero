#!/bin/sh
# pre-push hook — smoke test rápido antes de pushear
# Corre tests de templateEngine (52 tests, ~40ms) como sanity check.
# Si querés saltar: git push --no-verify

echo "🔍 Smoke test before push..."
npx vitest run src/lib/pdf/__tests__/templateEngine.test.js --reporter=verbose 2>&1 | tail -15
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Smoke test FAILED. Push cancelled."
  echo "   Use: git push --no-verify (not recommended)"
  exit 1
fi
echo "✅ Smoke test passed. Pushing..."
